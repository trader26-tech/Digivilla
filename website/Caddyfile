{
	admin off
	auto_https off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	# Compiled modules are fetched as dc/<name>.js?v=<build hash>, so they can be
	# cached for good; pages stay fresh so a new build is picked up at once.
	@code path /dc/*
	header @code Cache-Control "public, max-age=31536000, immutable"
	@media path /assets/* /_ds/*
	header @media Cache-Control "public, max-age=604800"
	@pages path / *.html /part-transitions.js
	header @pages Cache-Control "no-cache"

	header X-Content-Type-Options nosniff
	header Referrer-Policy strict-origin-when-cross-origin

	# /story → story.html
	try_files {path} {path}.html
	file_server
}
