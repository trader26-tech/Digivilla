# =============================================================================
# Client app environment variables
# -----------------------------------------------------------------------------
# For deployment (Railway etc.): DO NOT deploy this file. Set these as
# variables in the platform dashboard (Railway → your service → Variables).
# For local dev: copy this file to `.env` and fill in the blanks.
#
# Deploy checklist: set Root Directory = client, then paste the variables
# under "REQUIRED FOR PRODUCTION" below (defaults cover the rest).
# =============================================================================


# ---------------------------------------------------------------------------
# REQUIRED FOR PRODUCTION
# ---------------------------------------------------------------------------

# --- Supabase (Project Settings > API in the Supabase dashboard) ---
SUPABASE_URL=https://your-project-ref.supabase.co
# service_role key — server-side only, never expose to the browser
SUPABASE_SERVICE_KEY=your-service-role-key

# --- Secrets (use long random strings in production) ---
# Signs user auth tokens.
AUTH_SECRET=change-me-a-long-random-string
# Signs admin session tokens (distinct from AUTH_SECRET).
ADMIN_TOKEN_SECRET=change-me-a-different-long-random-string

# --- CORS: your public URL(s), comma-separated ---
# (*.up.railway.app is already allowed via CORS_ORIGIN_REGEX below.)
CORS_ORIGINS=https://your-app.up.railway.app

# --- Admin OTP → PIN sign-in ---
# Emails allowed to request an admin sign-in code (comma-separated; first is default).
OTP_ALLOWLIST=ranjeevfortrade@gmail.com
# Resend API key to deliver the code by email. If unset, the code is printed to
# the server log (dev only). Get one at https://resend.com.
RESEND_API_KEY=

# --- Firebase: backend admin (verifies phone-OTP ID tokens) ---
# Paste the FULL service-account JSON as a single value (one line).
FIREBASE_SERVICE_ACCOUNT=

# --- Firebase: frontend web config (enables REAL phone-OTP SMS) ---
# From Firebase Console → Project Settings → General → Your apps → Web app.
# Consumed at container startup to generate the frontend's env.js.
FIREBASE_API_KEY=
FIREBASE_APP_ID=


# ---------------------------------------------------------------------------
# OPTIONAL (sensible defaults; override only if needed)
# ---------------------------------------------------------------------------

# Regex to additionally allow deploy origins.
CORS_ORIGIN_REGEX=https://.*\.up\.railway\.app

# OTP email from-address.
OTP_FROM=onboarding@resend.dev
# Trusted-device lifetime (days) and idle auto-lock window (minutes).
DEVICE_TTL_DAYS=30
DEFAULT_LOCK_MINUTES=30

# Firebase frontend web config (defaults already match the mylakshayas project).
FIREBASE_AUTH_DOMAIN=mylakshayas.firebaseapp.com
FIREBASE_PROJECT_ID=mylakshayas
FIREBASE_MESSAGING_SENDER_ID=

# Frontend API URL — leave empty for same-origin (the combined deploy).
FRONTEND_API_URL=

# Legacy admin username/password fallback (primary login is the OTP flow above).
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# Local dev ONLY: trust client-supplied phone without Firebase Admin.
# MUST stay false/unset in production.
ALLOW_UNVERIFIED_PHONE=false
