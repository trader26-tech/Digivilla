# Admin API — copy to .env and fill in. All values are optional in dev:
# without Supabase, data is stored in local JSON files under app/data/.

# --- Shared Supabase database (SAME project as the client backend) ---
# So a booking confirmed in the admin is instantly visible in the client app.
SUPABASE_URL=https://your-project-ref.supabase.co
# Use the service_role key (server-side only, never expose to the browser)
SUPABASE_SERVICE_KEY=your-service-role-key

# Comma-separated list of allowed frontend origins for CORS. Include BOTH the
# admin SPA origin and the client SPA origin (both call this API cross-origin).
CORS_ORIGINS=http://localhost:4300,http://localhost:4200

# --- Admin OTP → PIN sign-in ---
# Secret used to sign admin session tokens (change in production).
ADMIN_TOKEN_SECRET=change-me-admin-secret
# Emails allowed to request an admin sign-in code (comma-separated; first is default).
OTP_ALLOWLIST=ranjeevfortrade@gmail.com
# Resend API key to deliver the code by email. If unset, the code is printed to
# the server log (dev only). Get one at https://resend.com.
RESEND_API_KEY=
OTP_FROM=onboarding@resend.dev
# Trusted-device lifetime and idle auto-lock window.
DEVICE_TTL_DAYS=30
DEFAULT_LOCK_MINUTES=30
